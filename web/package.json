{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "api": "node scripts/start-api.mjs",
    "build": "node --max-old-space-size=512 node_modules/vite/bin/vite.js build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:unit": "node --test tests/preview.test.mjs tests/project.test.mjs tests/project-timeline.test.mjs tests/resize.test.mjs tests/storyboard.test.mjs tests/timeline.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "^7.18.2",
    "vite": "6.4.2"
  }
}
